\fs40 \cf16 \uc0\u8203 \cf6 \
\
\cf16 Understanding the multi-agent loop\
\pard\pardeftab720\sa400\partightenfactor0

\fs32 \cf5 The core of computer use is the \'93agent loop\'94 - a cycle where Claude requests tool actions, your application executes them, and returns results to Claude. Here\'92s a simplified example:\
\pard\pardeftab720\qc\partightenfactor0
\cf26 \cb27 \
\pard\pardeftab720\partightenfactor0

\fs24 \cf9 \cb8 Copy\
\pard\pardeftab720\partightenfactor0

\fs28 \cf28 \cb25 async\cf26  \cf28 def\cf26  \cf35 sampling_loop\cf30 (\cf26 \
    \cf29 *\cf30 ,\cf26 \
    model\cf30 :\cf26  \cf31 str\cf30 ,\cf26 \
    messages\cf30 :\cf26  \cf31 list\cf30 [\cf31 dict\cf30 ],\cf26 \
    api_key\cf30 :\cf26  \cf31 str\cf30 ,\cf26 \
    max_tokens\cf30 :\cf26  \cf31 int\cf26  \cf29 =\cf26  \cf33 4096\cf30 ,\cf26 \
    tool_version\cf30 :\cf26  \cf31 str\cf30 ,\cf26 \
    thinking_budget\cf30 :\cf26  \cf31 int\cf26  \cf29 |\cf26  \cf28 None\cf26  \cf29 =\cf26  \cf28 None\cf30 ,\cf26 \
    max_iterations\cf30 :\cf26  \cf31 int\cf26  \cf29 =\cf26  \cf33 10\cf30 ,\cf26   \cf32 # Add iteration limit to prevent infinite loops\cf26 \
\cf30 ):\cf26 \
    \cf31 ""\cf26 "\
    A simple agent loop \cf28 for\cf26  Claude computer use interactions\cf30 .\cf26 \
\
    This function handles the back\cf29 -\cf28 and\cf29 -\cf26 forth between\cf30 :\cf26 \
    \cf33 1.\cf26  Sending user messages to Claude\
    \cf33 2.\cf26  Claude requesting to use tools\
    \cf33 3.\cf26  Your app executing those tools\
    \cf33 4.\cf26  Sending tool results back to Claude\
    \cf31 ""\cf26 "\
    \cf32 # Set up tools and API parameters\cf26 \
    client \cf29 =\cf26  Anthropic\cf30 (\cf26 api_key\cf29 =\cf26 api_key\cf30 )\cf26 \
    beta_flag \cf29 =\cf26  \cf31 "computer-use-2025-01-24"\cf26  \cf28 if\cf26  \cf31 "20250124"\cf26  \cf28 in\cf26  tool_version \cf28 else\cf26  \cf31 "computer-use-2024-10-22"\cf26 \
\
    \cf32 # Configure tools - you should already have these initialized elsewhere\cf26 \
    tools \cf29 =\cf26  \cf30 [\cf26 \
        \cf30 \{\cf31 "type"\cf30 :\cf26  \cf31 f"computer_\cf30 \{\cf36 tool_version\cf30 \}\cf31 "\cf30 ,\cf26  \cf31 "name"\cf30 :\cf26  \cf31 "computer"\cf30 ,\cf26  \cf31 "display_width_px"\cf30 :\cf26  \cf33 1024\cf30 ,\cf26  \cf31 "display_height_px"\cf30 :\cf26  \cf33 768\cf30 \},\cf26 \
        \cf30 \{\cf31 "type"\cf30 :\cf26  \cf31 f"text_editor_\cf30 \{\cf36 tool_version\cf30 \}\cf31 "\cf30 ,\cf26  \cf31 "name"\cf30 :\cf26  \cf31 "str_replace_editor"\cf30 \},\cf26 \
        \cf30 \{\cf31 "type"\cf30 :\cf26  \cf31 f"bash_\cf30 \{\cf36 tool_version\cf30 \}\cf31 "\cf30 ,\cf26  \cf31 "name"\cf30 :\cf26  \cf31 "bash"\cf30 \}\cf26 \
    \cf30 ]\cf26 \
\
    \cf32 # Main agent loop (with iteration limit to prevent runaway API costs)\cf26 \
    iterations \cf29 =\cf26  \cf33 0\cf26 \
    \cf28 while\cf26  \cf28 True\cf26  \cf28 and\cf26  iterations \cf29 <\cf26  max_iterations\cf30 :\cf26 \
        iterations \cf29 +=\cf26  \cf33 1\cf26 \
        \cf32 # Set up optional thinking parameter (for Claude Sonnet 3.7)\cf26 \
        thinking \cf29 =\cf26  \cf28 None\cf26 \
        \cf28 if\cf26  thinking_budget\cf30 :\cf26 \
            thinking \cf29 =\cf26  \cf30 \{\cf31 "type"\cf30 :\cf26  \cf31 "enabled"\cf30 ,\cf26  \cf31 "budget_tokens"\cf30 :\cf26  thinking_budget\cf30 \}\cf26 \
\
        \cf32 # Call the Claude API\cf26 \
        response \cf29 =\cf26  client\cf30 .\cf26 beta\cf30 .\cf26 messages\cf30 .\cf26 create\cf30 (\cf26 \
            model\cf29 =\cf26 model\cf30 ,\cf26 \
            max_tokens\cf29 =\cf26 max_tokens\cf30 ,\cf26 \
            messages\cf29 =\cf26 messages\cf30 ,\cf26 \
            tools\cf29 =\cf26 tools\cf30 ,\cf26 \
            betas\cf29 =\cf30 [\cf26 beta_flag\cf30 ],\cf26 \
            thinking\cf29 =\cf26 thinking\
        \cf30 )\cf26 \
\
        \cf32 # Add Claude's response to the conversation history\cf26 \
        response_content \cf29 =\cf26  response\cf30 .\cf26 content\
        messages\cf30 .\cf26 append\cf30 (\{\cf31 "role"\cf30 :\cf26  \cf31 "assistant"\cf30 ,\cf26  \cf31 "content"\cf30 :\cf26  response_content\cf30 \})\cf26 \
\
        \cf32 # Check if Claude used any tools\cf26 \
        tool_results \cf29 =\cf26  \cf30 []\cf26 \
        \cf28 for\cf26  block \cf28 in\cf26  response_content\cf30 :\cf26 \
            \cf28 if\cf26  block\cf30 .\cf31 type\cf26  \cf29 ==\cf26  \cf31 "tool_use"\cf30 :\cf26 \
                \cf32 # In a real app, you would execute the tool here\cf26 \
                \cf32 # For example: result = run_tool(block.name, block.input)\cf26 \
                result \cf29 =\cf26  \cf30 \{\cf31 "result"\cf30 :\cf26  \cf31 "Tool executed successfully"\cf30 \}\cf26 \
\
                \cf32 # Format the result for Claude\cf26 \
                tool_results\cf30 .\cf26 append\cf30 (\{\cf26 \
                    \cf31 "type"\cf30 :\cf26  \cf31 "tool_result"\cf30 ,\cf26 \
                    \cf31 "tool_use_id"\cf30 :\cf26  block\cf30 .\cf31 id\cf30 ,\cf26 \
                    \cf31 "content"\cf30 :\cf26  result\
                \cf30 \})\cf26 \
\
        \cf32 # If no tools were used, Claude is done - return the final messages\cf26 \
        \cf28 if\cf26  \cf28 not\cf26  tool_results\cf30 :\cf26 \
            \cf28 return\cf26  messages\
\
        \cf32 # Add tool results to messages for the next iteration with Claude\cf26 \
        messages\cf30 .\cf26 append\cf30 (\{\cf31 "role"\cf30 :\cf26  \cf31 "user"\cf30 ,\cf26  \cf31 "content"\cf30 :\cf26  tool_results\cf30 \})\cf26 \
\pard\pardeftab720\sa400\partightenfactor0

